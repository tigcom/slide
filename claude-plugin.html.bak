                <div class="slide-footer reveal d6">
                    <span>Claude + Plugin</span>
                    <span>2026</span>
                </div>
            </div>
        </section>

    </main>
</div>

<!-- Edit hotzone + toggle -->
<div class="edit-hotzone" id="editHotzone"></div>
<button class="edit-toggle" id="editToggle" title="Chỉnh sửa (E)">✏️</button>

<!-- Deck controls (outside slide stage) -->
<div class="deck-controls">
    <button id="prevBtn" title="Phím ←">‹</button>
    <span id="pageLabel">01 / 26</span>
    <button id="nextBtn" title="Phím →">›</button>
</div>

<script>
/* ============================================================
   FIXED 16:9 STAGE SCALING
   ============================================================ */
(function () {
    var stage = document.getElementById('deckStage');
    function fit() {
        var f = Math.min(window.innerWidth / 1920, window.innerHeight / 1080);
        stage.style.transform = 'translate(' + ((window.innerWidth - 1920 * f) / 2) + 'px,' +
            ((window.innerHeight - 1080 * f) / 2) + 'px) scale(' + f + ')';
    }
    window.addEventListener('resize', fit);
    fit();
})();

/* ============================================================
   SLIDE PRESENTATION CONTROLLER
   ============================================================ */
(function () {
    var slides = Array.prototype.slice.call(document.querySelectorAll('.slide'));
    var total = slides.length;
    var current = 0;
    var pageLabel = document.getElementById('pageLabel');

    function pad(n) { return (n < 10 ? '0' : '') + n; }

    // Auto-number folios (top-right) on each slide
    slides.forEach(function (s, i) {
        var f = s.querySelector('.folio');
        if (f) { f.textContent = pad(i + 1) + ' / ' + pad(total); }
    });

    function show(index) {
        current = Math.max(0, Math.min(index, total - 1));
        slides.forEach(function (s, i) {
            s.classList.toggle('active', i === current);
            s.classList.toggle('visible', i === current);
        });
        if (pageLabel) { pageLabel.textContent = pad(current + 1) + ' / ' + pad(total); }
    }

    function next() { show(current + 1); }
    function prev() { show(current - 1); }

    // Keyboard
    document.addEventListener('keydown', function (e) {
        if (e.target && e.target.getAttribute && e.target.getAttribute('contenteditable') === 'true') return;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === ' ' || e.key === 'PageDown') {
            e.preventDefault(); next();
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp' || e.key === 'PageUp') {
            e.preventDefault(); prev();
        } else if (e.key === 'Home') { e.preventDefault(); show(0); }
        else if (e.key === 'End') { e.preventDefault(); show(total - 1); }
    });

    // Mouse wheel
    var wheelLock = false;
    window.addEventListener('wheel', function (e) {
        if (wheelLock) return;
        wheelLock = true;
        setTimeout(function () { wheelLock = false; }, 500);
        if (e.deltaY > 0) { next(); } else { prev(); }
    }, { passive: true });

    // Touch swipe
    var touchX = null, touchY = null;
    window.addEventListener('touchstart', function (e) {
        touchX = e.touches[0].clientX; touchY = e.touches[0].clientY;
    }, { passive: true });
    window.addEventListener('touchend', function (e) {
        if (touchX === null) return;
        var dx = e.changedTouches[0].clientX - touchX;
        var dy = e.changedTouches[0].clientY - touchY;
        if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy)) {
            if (dx < 0) { next(); } else { prev(); }
        }
        touchX = touchY = null;
    }, { passive: true });

    // Control buttons
    document.getElementById('nextBtn').addEventListener('click', next);
    document.getElementById('prevBtn').addEventListener('click', prev);

    show(0);
})();

/* ============================================================
   QR CHECK-IN (flip clock 35s → flip to QR)
   ============================================================ */
(function () {
    var slide = document.getElementById('qaCountdownSlide');
    var stage = document.getElementById('flipStage');
    if (!slide || !stage) return;

    var TOTAL = 35;
    var remaining = TOTAL;
    var timer = null;

    var tensEl = document.getElementById('dTens');
    var onesEl = document.getElementById('dOnes');
    var title = document.getElementById('qrTitle');

    function pad(n) { return (n < 10 ? '0' : '') + n; }

    function setDigit(el, val) {
        var cur = el.getAttribute('data-value');
        if (cur === val) return;
        el.setAttribute('data-value', val);

        var from = (cur === null) ? val : cur;
        var topSpan = el.querySelector('.static-top span');
        var botSpan = el.querySelector('.static-bottom span');
        var flapTop = el.querySelector('.flap-top');
        var flapBot = el.querySelector('.flap-bottom');

        flapTop.querySelector('span').textContent = from; // old top folds down
        flapBot.querySelector('span').textContent = val;  // new bottom unfolds
        topSpan.textContent = val;                        // new top revealed behind

        el.classList.remove('flipping');
        void el.offsetWidth; // restart animation
        el.classList.add('flipping');

        clearTimeout(el._t);
        el._t = setTimeout(function () {
            botSpan.textContent = val;
            flapTop.querySelector('span').textContent = val;
            flapBot.querySelector('span').textContent = val;
            el.classList.remove('flipping');
        }, 700);
    }

    function render() {
        var s = pad(remaining);
        setDigit(tensEl, s.charAt(0));
        setDigit(onesEl, s.charAt(1));
    }

    function stop() { if (timer) { clearInterval(timer); timer = null; } }

    function start() {
        stop();
        remaining = TOTAL;
        stage.classList.remove('is-flipped');
        title.classList.remove('is-qr');

        var init = pad(TOTAL);
        [tensEl, onesEl].forEach(function (el, i) {
            var v = init.charAt(i);
            el.setAttribute('data-value', v);
            el.querySelector('.static-top span').textContent = v;
            el.querySelector('.static-bottom span').textContent = v;
            el.querySelector('.flap-top span').textContent = v;
            el.querySelector('.flap-bottom span').textContent = v;
            el.classList.remove('flipping');
        });

        timer = setInterval(function () {
            remaining -= 1;
            if (remaining < 0) { remaining = 0; }
            render();
            if (remaining === 0) {
                stop();
                setTimeout(function () {
                    stage.classList.add('is-flipped');
                    title.classList.add('is-qr');
                }, 900);
            }
        }, 1000);
    }

    // Restart when the slide becomes active, stop when it leaves.
    var observer = new MutationObserver(function () {
        if (slide.classList.contains('active')) { start(); } else { stop(); }
    });
    observer.observe(slide, { attributes: true, attributeFilter: ['class'] });

    if (slide.classList.contains('active')) { start(); }
})();

/* ============================================================
   SHRINKING MESSAGE (per-word font-size taper)
   ============================================================ */
(function () {
    var roots = document.querySelectorAll('.shrink');
    var STEP = 3; // 1px smaller per word

    function wrap(root) {
        var base = parseFloat(window.getComputedStyle(root).fontSize) || 40;
        var count = 0;
        function walk(node) {
            Array.prototype.slice.call(node.childNodes).forEach(function (child) {
                if (child.nodeType === 3) {
                    var frag = document.createDocumentFragment();
                    (child.nodeValue.match(/\S+|\s+/g) || []).forEach(function (tok) {
                        if (!/\S/.test(tok)) {
                            // whitespace: keep as plain text, don't shrink / don't count
                            frag.appendChild(document.createTextNode(tok));
                            return;
                        }
                        var s = document.createElement('span');
                        s.textContent = tok;
                        s.style.fontSize = Math.max(1, base - count * STEP) + 'px';
                        count += 1;
                        frag.appendChild(s);
                    });
                    node.replaceChild(frag, child);
                } else if (child.nodeType === 1) {
                    walk(child);
                }
            });
        }
        walk(root);
    }

    Array.prototype.forEach.call(roots, wrap);
})();

/* ============================================================
   INLINE EDITING (E key / hover hotzone / Ctrl+S to save)
   ============================================================ */
(function () {
    var editor = {
        isActive: false,
        toggle: function () {
            this.isActive = !this.isActive;
            document.body.classList.toggle('editing', this.isActive);
            document.getElementById('editToggle').classList.toggle('active', this.isActive);
            var slides = document.querySelectorAll('.slide');
            slides.forEach(function (s) {
                if (editor.isActive) {
                    s.setAttribute('contenteditable', 'true');
                } else {
                    s.removeAttribute('contenteditable');
                }
            });
        }
    };

    var toggle = document.getElementById('editToggle');
    var hotzone = document.getElementById('editHotzone');
    var hideTimeout = null;

    function showBtn() { clearTimeout(hideTimeout); toggle.classList.add('show'); }
    function hideBtnSoon() {
        hideTimeout = setTimeout(function () {
            if (!editor.isActive) { toggle.classList.remove('show'); }
        }, 400);
    }

    toggle.addEventListener('click', function () { editor.toggle(); });
    hotzone.addEventListener('mouseenter', showBtn);
    hotzone.addEventListener('mouseleave', hideBtnSoon);
    hotzone.addEventListener('click', function () { editor.toggle(); });
    toggle.addEventListener('mouseenter', showBtn);
    toggle.addEventListener('mouseleave', hideBtnSoon);

    document.addEventListener('keydown', function (e) {
        var editing = e.target && e.target.getAttribute && e.target.getAttribute('contenteditable') === 'true';
        if ((e.key === 'e' || e.key === 'E') && !editing) { editor.toggle(); }
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
            e.preventDefault();
            if (editor.isActive) {
                var stage = document.getElementById('deckStage');
                localStorage.setItem('claude-plugin-deck', stage.innerHTML);
                console.log('Đã lưu vào localStorage.');
            }
        }
    });

    // Restore saved edits on load
    var saved = localStorage.getItem('claude-plugin-deck');
    if (saved) {
        document.getElementById('deckStage').innerHTML = saved;
    }
})();
</script>
</body>
</html>
