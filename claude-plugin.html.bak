<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Claude + Plugin</title>

<!-- Fonts: Source Serif 4 (display) + DM Sans (body) + IBM Plex Mono (chrome) — all support Vietnamese -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500;700&display=swap" rel="stylesheet">

<style>
/* ============================================================
   THEME TOKENS — merged: Signal layout + Swiss palette + Claude effects
   - Bố cục editorial (B): serif headline, mono chrome, hairline rules
   - Màu (A): trắng / đen / đỏ #ff3300
   - Hiệu ứng (C): con trỏ nhấp nháy, glow, staggered reveal
   ============================================================ */
:root {
    /* Surface */
    --stage-bg: #0a0a0a;
    --paper: #ffffff;
    --ink: #0a0a0a;
    --ink-soft: #33312e;
    --muted: #6b6b6b;
    --faint: #9a9a9a;

    /* Lines & grid */
    --line: #e6e3dc;
    --grid: #efede8;

    /* Accent — single red (from Style A) */
    --red: #ff3300;
    --red-deep: #c92800;
    --red-soft: rgba(255, 51, 0, 0.10);
    --red-glow: rgba(255, 51, 0, 0.22);

    /* Typography */
    --font-serif: 'Source Serif 4', serif;
    --font-sans: 'DM Sans', sans-serif;
    --font-mono: 'IBM Plex Mono', monospace;

    --ease: cubic-bezier(0.16, 1, 0.3, 1);
}

* { margin: 0; padding: 0; box-sizing: border-box; }

/* ============================================================
   FIXED 16:9 STAGE — MANDATORY BASE (viewport-base.css)
   ============================================================ */
html, body {
    width: 100%; height: 100%; margin: 0; overflow: hidden;
    background: var(--stage-bg, #000);
}
.deck-viewport {
    position: fixed; inset: 0; overflow: hidden;
    background: var(--stage-bg, #000);
}
.deck-stage {
    position: absolute; left: 0; top: 0;
    width: 1920px; height: 1080px; overflow: hidden;
    transform-origin: 0 0; background: var(--paper);
}
.slide {
    position: absolute; inset: 0;
    width: 1920px; height: 1080px; overflow: hidden;
    display: block; visibility: hidden; opacity: 0; pointer-events: none;
    background: var(--paper);
}
.slide.active, .slide.visible {
    visibility: visible; opacity: 1; pointer-events: auto; z-index: 1;
}
img, video, canvas, svg { max-width: 100%; max-height: 100%; }
.deck-controls {
    position: fixed; left: 50%; bottom: 22px;
    transform: translateX(-50%); z-index: 1000;
}
@media print {
    html, body { width: 1920px; height: auto; overflow: visible; background: #fff; }
    .deck-viewport { position: static; overflow: visible; background: #fff; }
    .deck-stage { position: static; width: auto; height: auto; transform: none !important; background: none; }
    .slide { position: relative; display: block !important; visibility: visible !important; opacity: 1 !important; pointer-events: auto !important; width: 1920px; height: 1080px; break-after: page; page-break-after: always; }
    .slide:last-child { break-after: auto; page-break-after: auto; }
    .deck-controls { display: none !important; }
}
@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.2s !important; }
}

/* ============================================================
   COMMON CHROME (editorial top bar + hairline + footer)
   ============================================================ */
.slide-inner {
    position: absolute; inset: 0;
    padding: 76px 96px 64px;
    display: flex; flex-direction: column;
}
.chrome {
    display: flex; justify-content: space-between; align-items: baseline;
    font-family: var(--font-mono);
    font-size: 22px; font-weight: 500;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--muted);
}
.chrome .kicker b { color: var(--red); font-weight: 700; }
.chrome .folio { color: var(--ink); }
.chrome .folio em { color: var(--red); font-style: normal; }
em2 { color: var(--faint); font-style: normal; }
.rule {
    height: 1px; background: var(--ink); opacity: 0.85;
    margin-top: 20px;
}
.rule.soft { background: var(--line); opacity: 1; }

.slide-footer {
    margin-top: auto;
    display: flex; justify-content: space-between; align-items: baseline;
    font-family: var(--font-mono);
    font-size: 20px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--faint);
    padding-top: 20px;
}
.slide-footer b { color: var(--red); font-weight: 500; }

/* Faint structural grid (from Style A) */
.grid-overlay {
    position: absolute; inset: 0; pointer-events: none;
    background-image:
        linear-gradient(var(--grid) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 100px 100px;
    opacity: 0.55;
}

/* ============================================================
   ENTRANCE ANIMATION (staggered reveal)
   ============================================================ */
.reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.55s var(--ease), transform 0.55s var(--ease);
}
.slide.visible .reveal { opacity: 1; transform: translateY(0); }
.d1 { transition-delay: 0.10s; }
.d2 { transition-delay: 0.20s; }
.d3 { transition-delay: 0.30s; }
.d4 { transition-delay: 0.40s; }
.d5 { transition-delay: 0.50s; }
.d6 { transition-delay: 0.60s; }

/* ============================================================
   BLINKING CURSOR (from Style C, recolored red)
   ============================================================ */
.cursor {
    display: inline-block;
    width: 0.55em; height: 1.05em;
    background: var(--red);
    vertical-align: -0.12em; margin-left: 0.25em;
    animation: blink 1.1s steps(1) infinite;
}
@keyframes blink { 50% { opacity: 0; } }

/* ============================================================
   COVER SLIDE
   ============================================================ */
.cover { background: var(--paper); }
.cover .glow {
    position: absolute; inset: 0; pointer-events: none;
    background:
        radial-gradient(ellipse 900px 600px at 80% 18%, var(--red-glow) 0%, transparent 60%),
        radial-gradient(ellipse 700px 500px at 12% 88%, var(--red-soft) 0%, transparent 60%);
}
.cover .title-block { margin-top: auto; padding: 36px 0; }
.cover .display {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 176px;
    line-height: 1.0;
    letter-spacing: -0.01em;
    color: var(--ink);
}
.cover .display em { font-style: italic; color: var(--red); }
.cover .subtitle {
    margin-top: 40px;
    font-family: var(--font-sans);
    font-size: 38px; font-weight: 400;
    color: var(--muted);
    max-width: 1250px;
}

/* ============================================================
   SECTION DIVIDER SLIDES (dark surface + red glow + cursor)
   ============================================================ */
.divider { background: var(--ink); }
.divider .glow {
    position: absolute; inset: 0; pointer-events: none;
    background:
        radial-gradient(ellipse 800px 520px at 80% 20%, var(--red-glow) 0%, transparent 60%),
        radial-gradient(ellipse 600px 460px at 15% 85%, rgba(255,51,0,0.12) 0%, transparent 60%);
}
.divider .grid-overlay {
    background-image:
        linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 90px 90px;
}
.divider-inner {
    position: absolute; inset: 0;
    padding: 120px 120px 96px;
    display: flex; flex-direction: column;
    justify-content: center;
}
.divider-num {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 180px;
    line-height: 1;
    color: var(--red);
}
.divider-rule { width: 180px; height: 6px; background: var(--red); margin: 34px 0; }
.divider-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 92px;
    line-height: 1.06;
    color: #ffffff;
    max-width: 1450px;
}
.divider-title em { font-style: italic; color: var(--red); }
.divider-meta {
    margin-top: 44px;
    font-family: var(--font-mono);
    font-size: 28px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--muted);
}
.divider-meta b { color: #ffffff; font-weight: 500; }

/* ============================================================
   STATEMENT SLIDES (eyebrow label + big serif lines)
   ============================================================ */
.eyebrow {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 26px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--red);
    margin-bottom: 40px;
}
.statement { margin-top: auto; margin-bottom: auto; max-width: 1680px; }
.statement .line {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 66px;
    line-height: 1.18;
    color: var(--ink);
}
.statement .line + .line { margin-top: 28px; }
.statement .line em { font-style: italic; color: var(--red); }

/* ============================================================
   BULLETS SLIDES
   ============================================================ */
.h-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 60px;
    line-height: 1.08;
    color: var(--ink);
    margin-top: 44px;
    max-width: 1600px;
}
.h-title em { font-style: italic; color: var(--red); }
.bullets {
    list-style: none;
    margin-top: 44px;
    display: flex; flex-direction: column; gap: 30px;
    max-width: 1660px;
}
.bullets li {
    display: flex; gap: 28px; align-items: flex-start;
    font-family: var(--font-sans);
    font-size: 34px; font-weight: 400;
    line-height: 1.42;
    color: var(--ink-soft);
}
.bullets li::before {
    content: "";
    flex: 0 0 14px;
    width: 14px; height: 14px;
    margin-top: 16px;
    background: var(--red);
}
.bullets li b { color: var(--ink); font-weight: 700; }

/* ============================================================
   TABLE SLIDES
   ============================================================ */
.table-wrap {
    margin-top: 40px;
    width: 100%;
}
table.data {
    width: 100%;
    border-collapse: collapse;
}
table.data thead th {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 23px;
    letter-spacing: 0.10em; text-transform: uppercase;
    color: var(--muted);
    text-align: left;
    padding: 16px 22px 18px;
    border-bottom: 3px solid var(--red);
}
table.data tbody td {
    font-family: var(--font-sans);
    font-size: 30px; font-weight: 400;
    line-height: 1.38;
    color: var(--ink-soft);
    padding: 22px 22px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
}
table.data tbody tr:last-child td { border-bottom: none; }
table.data td b { color: var(--ink); font-weight: 700; }
table.data td.idx {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--red);
    white-space: nowrap;
}

/* ============================================================
   QR CHECK-IN SLIDE (flip clock 35s → flip to QR)
   ============================================================ */
.qr-checkin {
    margin: auto 0;
    display: flex; flex-direction: column; align-items: center;
    text-align: center;
}
.qr-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 104px;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--ink);
    display: grid;
}
.qr-title em { font-style: italic; color: var(--red); }
.qr-swap {
    grid-area: 1 / 1;
    transition: opacity 0.55s var(--ease), transform 0.55s var(--ease);
}
.qr-swap.qr-b {
    opacity: 0;
    transform: translateY(18px);
}
.qr-title.is-qr .qr-swap.qr-a { opacity: 0; transform: translateY(-18px); }
.qr-title.is-qr .qr-swap.qr-b { opacity: 1; transform: translateY(0); }
.qr-message {
    font-family: var(--font-serif);
    font-size: 40px;
    line-height: 1.4;
    color: var(--ink);
    margin-top: 30px;
    max-width: 1320px;
}
.qr-message em { font-style: italic; color: var(--red); }
.qr-row {
    display: flex;
    align-items: center;
    gap: 48px;
    margin-top: 30px;
}
.qr-row .qr-message {
    margin-top: 0;
    text-align: left;
    max-width: 780px;
}

/* 3D flip stage — front: flip clock, back: square QR */
.flip-stage {
    margin-top: 58px;
    width: 520px;
    height: 330px;
    perspective: 1400px;
}
.flip-stage-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 1.05s var(--ease);
}
.flip-stage.is-flipped .flip-stage-inner { transform: rotateY(180deg); }
.flip-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}
.flip-back { transform: rotateY(180deg); }
.load-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 0 0 auto;
}
.qr-img {
    width: 300px; height: 300px;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 26px 70px rgba(0,0,0,0.16);
}
.qr-caption {
    font-family: var(--font-mono);
    font-size: 22px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 16px;
}

/* Split-flap clock */
.flip-clock {
    display: flex;
    align-items: center;
    gap: 22px;
}
.clock-digit {
    position: relative;
    width: 150px;
    height: 210px;
    perspective: 800px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 170px;
    line-height: 210px;
    color: #fff;
}
.clock-digit .half {
    position: absolute;
    left: 0;
    width: 100%;
    height: 50%;
    overflow: hidden;
    background: #101010;
}
.clock-digit .half span,
.clock-digit .flap-top span,
.clock-digit .flap-bottom span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 210px;
    line-height: 210px;
    text-align: center;
}
.clock-digit .static-top { top: 0; border-radius: 16px 16px 0 0; z-index: 1; }
.clock-digit .static-top span { top: 0; }
.clock-digit .static-bottom { bottom: 0; border-radius: 0 0 16px 16px; z-index: 1; }
.clock-digit .static-bottom span { bottom: 0; }
.clock-digit .half::after {
    content: '';
    position: absolute;
    left: 0; right: 0;
    height: 1px;
    background: rgba(255,255,255,0.10);
    z-index: 5;
}
.clock-digit .static-top::after { bottom: 0; }
.clock-digit .static-bottom::after { top: 0; }

.clock-digit .flap-top,
.clock-digit .flap-bottom {
    position: absolute;
    left: 0;
    width: 100%;
    height: 50%;
    overflow: hidden;
    background: #101010;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    will-change: transform;
}
.clock-digit .flap-top {
    top: 0;
    border-radius: 16px 16px 0 0;
    transform-origin: 50% 100%;
    z-index: 3;
    transform: rotateX(0deg);
}
.clock-digit .flap-bottom {
    bottom: 0;
    border-radius: 0 0 16px 16px;
    transform-origin: 50% 0%;
    z-index: 4;
    transform: rotateX(90deg);
}
.clock-digit .flap-top span { top: 0; }
.clock-digit .flap-bottom span { bottom: 0; }

.clock-digit.flipping .flap-top { animation: qr-flip-top 0.32s var(--ease) forwards; }
.clock-digit.flipping .flap-bottom { animation: qr-flip-bottom 0.32s var(--ease) 0.32s forwards; }
@keyframes qr-flip-top {
    from { transform: rotateX(0deg); }
    to   { transform: rotateX(-90deg); }
}
@keyframes qr-flip-bottom {
    from { transform: rotateX(90deg); }
    to   { transform: rotateX(0deg); }
}

.clock-unit-label {
    font-family: var(--font-mono);
    font-size: 20px;
    letter-spacing: 0.30em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 20px;
}

/* Hamster loading spinner (Uiverse.io by Nawsome — recolored to site red) */
.wheel-and-hamster {
    --dur: 1s;
    position: relative;
    width: 12em;
    height: 12em;
    font-size: 14px;
}
.wheel,
.hamster,
.hamster div,
.spoke { position: absolute; }
.wheel,
.spoke {
    border-radius: 50%;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}
.wheel {
    background: radial-gradient(100% 100% at center, hsla(0,0%,60%,0) 47.8%, hsl(0,0%,60%) 48%);
    z-index: 2;
}
.hamster {
    animation: hamster var(--dur) ease-in-out infinite;
    top: 50%;
    left: calc(50% - 3.5em);
    width: 7em;
    height: 3.75em;
    transform: rotate(4deg) translate(-0.8em, 1.85em);
    transform-origin: 50% 0;
    z-index: 1;
}
.hamster__head {
    animation: hamsterHead var(--dur) ease-in-out infinite;
    background: hsl(12, 100%, 50%);
    border-radius: 70% 30% 0 100% / 40% 25% 25% 60%;
    box-shadow: 0 -0.25em 0 hsl(12, 100%, 72%) inset,
        0.75em -1.55em 0 hsl(12, 100%, 88%) inset;
    top: 0;
    left: -2em;
    width: 2.75em;
    height: 2.5em;
    transform-origin: 100% 50%;
}
.hamster__ear {
    animation: hamsterEar var(--dur) ease-in-out infinite;
    background: hsl(12, 100%, 78%);
    border-radius: 50%;
    box-shadow: -0.25em 0 hsl(12, 100%, 50%) inset;
    top: -0.25em;
    right: -0.25em;
    width: 0.75em;
    height: 0.75em;
    transform-origin: 50% 75%;
}
.hamster__eye {
    animation: hamsterEye var(--dur) linear infinite;
    background-color: hsl(0, 0%, 0%);
    border-radius: 50%;
    top: 0.375em;
    left: 1.25em;
    width: 0.5em;
    height: 0.5em;
}
.hamster__nose {
    background: hsl(12, 100%, 40%);
    border-radius: 35% 65% 85% 15% / 70% 50% 50% 30%;
    top: 0.75em;
    left: 0;
    width: 0.2em;
    height: 0.25em;
}
.hamster__body {
    animation: hamsterBody var(--dur) ease-in-out infinite;
    background: hsl(12, 100%, 88%);
    border-radius: 50% 30% 50% 30% / 15% 60% 40% 40%;
    box-shadow: 0.1em 0.75em 0 hsl(12, 100%, 50%) inset,
        0.15em -0.5em 0 hsl(12, 100%, 72%) inset;
    top: 0.25em;
    left: 2em;
    width: 4.5em;
    height: 3em;
    transform-origin: 17% 50%;
    transform-style: preserve-3d;
}
.hamster__limb--fr,
.hamster__limb--fl {
    clip-path: polygon(0 0,100% 0,70% 80%,60% 100%,0% 100%,40% 80%);
    top: 2em;
    left: 0.5em;
    width: 1em;
    height: 1.5em;
    transform-origin: 50% 0;
}
.hamster__limb--fr {
    animation: hamsterFRLimb var(--dur) linear infinite;
    background: linear-gradient(hsl(12, 100%, 72%) 80%, hsl(12, 100%, 40%) 80%);
    transform: rotate(15deg) translateZ(-1px);
}
.hamster__limb--fl {
    animation: hamsterFLLimb var(--dur) linear infinite;
    background: linear-gradient(hsl(12, 100%, 88%) 80%, hsl(12, 100%, 78%) 80%);
    transform: rotate(15deg);
}
.hamster__limb--br,
.hamster__limb--bl {
    border-radius: 0.75em 0.75em 0 0;
    clip-path: polygon(0 0,100% 0,100% 30%,70% 90%,70% 100%,30% 100%,40% 90%,0% 30%);
    top: 1em;
    left: 2.8em;
    width: 1.5em;
    height: 2.5em;
    transform-origin: 50% 30%;
}
.hamster__limb--br {
    animation: hamsterBRLimb var(--dur) linear infinite;
    background: linear-gradient(hsl(12, 100%, 72%) 90%, hsl(12, 100%, 40%) 90%);
    transform: rotate(-25deg) translateZ(-1px);
}
.hamster__limb--bl {
    animation: hamsterBLLimb var(--dur) linear infinite;
    background: linear-gradient(hsl(12, 100%, 88%) 90%, hsl(12, 100%, 78%) 90%);
    transform: rotate(-25deg);
}
.hamster__tail {
    animation: hamsterTail var(--dur) linear infinite;
    background: hsl(12, 100%, 78%);
    border-radius: 0.25em 50% 50% 0.25em;
    box-shadow: 0 -0.2em 0 hsl(12, 100%, 40%) inset;
    top: 1.5em;
    right: -0.5em;
    width: 1em;
    height: 0.5em;
    transform: rotate(30deg) translateZ(-1px);
    transform-origin: 0.25em 0.25em;
}
.spoke {
    animation: spoke var(--dur) linear infinite;
    background: radial-gradient(100% 100% at center, hsl(0,0%,60%) 4.8%, hsla(0,0%,60%,0) 5%),
        linear-gradient(hsla(0,0%,55%,0) 46.9%, hsl(0,0%,65%) 47% 52.9%, hsla(0,0%,65%,0) 53%) 50% 50% / 99% 99% no-repeat;
}

/* Hamster animations */
@keyframes hamster {
    from, to { transform: rotate(4deg) translate(-0.8em, 1.85em); }
    50% { transform: rotate(0) translate(-0.8em, 1.85em); }
}
@keyframes hamsterHead {
    from, 25%, 50%, 75%, to { transform: rotate(0); }
    12.5%, 37.5%, 62.5%, 87.5% { transform: rotate(8deg); }
}
@keyframes hamsterEye {
    from, 90%, to { transform: scaleY(1); }
    95% { transform: scaleY(0); }
}
@keyframes hamsterEar {
    from, 25%, 50%, 75%, to { transform: rotate(0); }
    12.5%, 37.5%, 62.5%, 87.5% { transform: rotate(12deg); }
}
@keyframes hamsterBody {
    from, 25%, 50%, 75%, to { transform: rotate(0); }
    12.5%, 37.5%, 62.5%, 87.5% { transform: rotate(-2deg); }
}
@keyframes hamsterFRLimb {
    from, 25%, 50%, 75%, to { transform: rotate(50deg) translateZ(-1px); }
    12.5%, 37.5%, 62.5%, 87.5% { transform: rotate(-30deg) translateZ(-1px); }
}
@keyframes hamsterFLLimb {
    from, 25%, 50%, 75%, to { transform: rotate(-30deg); }
    12.5%, 37.5%, 62.5%, 87.5% { transform: rotate(50deg); }
}
@keyframes hamsterBRLimb {
    from, 25%, 50%, 75%, to { transform: rotate(-60deg) translateZ(-1px); }
    12.5%, 37.5%, 62.5%, 87.5% { transform: rotate(20deg) translateZ(-1px); }
}
@keyframes hamsterBLLimb {
    from, 25%, 50%, 75%, to { transform: rotate(20deg); }
    12.5%, 37.5%, 62.5%, 87.5% { transform: rotate(-60deg); }
}
@keyframes hamsterTail {
    from, 25%, 50%, 75%, to { transform: rotate(30deg) translateZ(-1px); }
    12.5%, 37.5%, 62.5%, 87.5% { transform: rotate(10deg) translateZ(-1px); }
}
@keyframes spoke {
    from { transform: rotate(0); }
    to { transform: rotate(-1turn); }
}

/* ============================================================
   INLINE EDIT TOGGLE
   ============================================================ */
.edit-hotzone {
    position: fixed; top: 0; left: 0;
    width: 80px; height: 80px; z-index: 10000; cursor: pointer;
}
.edit-toggle {
    position: fixed; top: 18px; left: 18px;
    width: 52px; height: 52px; border-radius: 50%;
    border: 1px solid var(--line); background: #fff;
    font-size: 24px; line-height: 1; cursor: pointer;
    opacity: 0; pointer-events: none;
    transition: opacity 0.3s ease;
    z-index: 10001;
    box-shadow: 0 6px 20px rgba(0,0,0,0.12);
}
.edit-toggle.show, .edit-toggle.active { opacity: 1; pointer-events: auto; }
body.editing .slide { outline: 2px dashed var(--red); outline-offset: -4px; }
body.editing [contenteditable="true"]:hover { background: rgba(255,51,0,0.06); }

/* ============================================================
   DECK CONTROLS (outside the slide stage)
   ============================================================ */
.deck-controls {
    display: flex; align-items: center; gap: 14px;
    font-family: var(--font-mono); font-size: 15px; color: #777;
}
.deck-controls button {
    font-family: var(--font-mono); font-size: 15px;
    border: 1px solid #333; background: rgba(20,20,20,0.7); color: #ccc;
    border-radius: 6px; padding: 6px 12px; cursor: pointer;
}
.deck-controls button:hover { background: rgba(40,40,40,0.9); color: #fff; }
</style>
</head>
