        <!-- qa-1 — QR điểm danh (flip clock 35s → flip to QR) -->
        <section class="slide" id="qaCountdownSlide">
            <div class="grid-overlay"></div>
            <div class="slide-inner">
                <header class="chrome reveal d1">
                    <span class="kicker">Phần <b>06</b> · Q&amp;A</span>
